ninja_required_version = 1.3
cxx = c++
nvcc = /opt/rocm-7.2.4/bin/hipcc

cflags = -D_GLIBCXX_USE_CXX11_ABI=1 -DAITER_EXTENSION_NAME=module_aiter_core -DTORCH_EXTENSION_NAME=module_aiter_core -I/var/home/my_aiter/aiter/3rdparty/ck_helper -I/var/home/my_aiter/aiter/3rdparty/composable_kernel/include -I/var/home/my_aiter/aiter/3rdparty/composable_kernel/library/include -I/var/home/my_aiter/aiter/csrc/include -I/var/home/my_InferenceX/InferenceX/local_bench_qwen3.8/.qsa_aiter_jit/build/module_aiter_core/blob -I/opt/venv/lib/python3.12/site-packages/pybind11/include -isystem /usr/include/python3.12 -fPIC -std=c++20 -O3 -std=c++20 -Wno-unknown-warning-option -DENABLE_ROPE_POSITIONS_INT32=0 -DENABLE_CK=0
post_cflags = -fPIC -D__HIP_PLATFORM_AMD__=1 -DUSE_ROCM=1 -DHIPBLAS_V2
cuda_cflags = -DWITH_HIP -D_GLIBCXX_USE_CXX11_ABI=1 -DAITER_EXTENSION_NAME=module_aiter_core -DTORCH_EXTENSION_NAME=module_aiter_core -I/var/home/my_aiter/aiter/3rdparty/ck_helper -I/var/home/my_aiter/aiter/3rdparty/composable_kernel/include -I/var/home/my_aiter/aiter/3rdparty/composable_kernel/library/include -I/var/home/my_aiter/aiter/csrc/include -I/var/home/my_InferenceX/InferenceX/local_bench_qwen3.8/.qsa_aiter_jit/build/module_aiter_core/blob -I/opt/venv/lib/python3.12/site-packages/pybind11/include -isystem /usr/include/python3.12 -fPIC -std=c++20 -O3 -std=c++20 -Wno-unknown-warning-option -DENABLE_ROPE_POSITIONS_INT32=0 -DENABLE_CK=0 -fPIC -D__HIP_PLATFORM_AMD__=1 -DUSE_ROCM=1 -DHIPBLAS_V2 -DCUDA_HAS_FP16=1 -D__HIP_NO_HALF_OPERATORS__=1 -D__HIP_NO_HALF_CONVERSIONS__=1 -mcmodel=large -fno-unique-section-names -ffunction-sections -fdata-sections -fvisibility=hidden -fvisibility-inlines-hidden --offload-arch=native -DDLLVM_MAIN_REVISION=554785 -DENABLE_CK=0 -DENABLE_ROPE_POSITIONS_INT32=0 -DLEGACY_HIPBLAS_DIRECT -DUSE_PROF_API=1 -D__Float4_e2m1fn_x2 -D__HIP_PLATFORM_AMD__=1 -D__HIP_PLATFORM_HCC__=1 -U__HIP_NO_HALF_CONVERSIONS__ -U__HIP_NO_HALF_OPERATORS__ -Wno-macro-redefined -Wno-missing-template-arg-list-after-template-kw -Wno-switch-bool -Wno-undefined-func-template -Wno-unused-result -Wno-vla-cxx-extension -fgpu-flush-denormals-to-zero -fno-offload-uniform-block -mllvm --amdgpu-kernarg-preload-count=32 -mllvm --lsr-drop-solution=1 -mllvm -amdgpu-early-inline-all=true -mllvm -amdgpu-function-calls=false -mllvm -enable-post-misched=0 -fno-gpu-rdc
cuda_post_cflags = 
cuda_dlink_post_cflags = 
ldflags = -shared -mcmodel=large -ffunction-sections -fdata-sections -Wl,--gc-sections -Wl,--cref -L/opt/rocm-7.2.4/lib -lamdhip64

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  command = $nvcc  $cuda_cflags -c $in -o $out $cuda_post_cflags



rule link
  command = $cxx @$out.rsp $ldflags -o $out
  rspfile = $out.rsp
  rspfile_content = $in

build aiter_core_pybind.cuda.o: cuda_compile /var/home/my_aiter/aiter/csrc/pybind/aiter_core_pybind.cu



build module_aiter_core.so: link aiter_core_pybind.cuda.o

default module_aiter_core.so
